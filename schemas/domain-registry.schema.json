{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personalized domain registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission", "release_data_policy", "routing_policy", "domains"],
  "properties": {
    "schema_version": {"const": "1"},
    "mission": {"type": "string", "minLength": 1},
    "release_data_policy": {"const": "public_config_and_synthetic_examples_only"},
    "routing_policy": {"const": "manual_or_configured_default_no_auto_detection"},
    "domains": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "tier", "goal", "routes", "sources", "public_repos", "links", "guardrails"],
        "properties": {
          "id": {"type":"string", "pattern":"^[a-z][a-z0-9_-]*$"},
          "tier": {"enum": ["core", "active"]},
          "goal": {"type": "string", "minLength": 1},
          "routes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "public_repos": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}},
          "links": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "guardrails": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
